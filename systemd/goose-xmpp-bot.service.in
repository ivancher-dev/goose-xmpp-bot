[Unit]
Description=Гусь: диагностический XMPP-сервис
After=network-online.target
Wants=network-online.target
# Ошибка после ограниченных попыток требует вмешательства владельца.

[Service]
Type=simple
User=goose-xmpp-bot
Group=goose-xmpp-bot
EnvironmentFile=@ENV_FILE@
ExecStart=@PREFIX@/venv/bin/goose-bot run --config @CONFIG@
WorkingDirectory=@PREFIX@
UMask=0077
Restart=no
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
